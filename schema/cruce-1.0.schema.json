{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polco.local/schemas/cruce-oc-proveedor/1.0",
  "title": "Cruce Orden de Compra vs Confirmación de Proveedor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "status", "confirmed_at", "notes", "purchase_order", "supplier_confirmation", "cross_checks", "statistics", "items"],
  "$defs": {
    "money": { "type": "number" },
    "nmoney": { "type": ["number", "null"] },
    "issue": { "type": "object", "additionalProperties": false, "required": ["severity", "code", "message", "line_number"],
      "properties": { "severity": { "enum": ["error", "warning", "info"] }, "code": { "type": "string" }, "message": { "type": "string" }, "line_number": { "type": ["integer", "null"] } } },
    "side": { "type": ["object", "null"], "additionalProperties": false,
      "required": ["description", "quantity", "unit_price", "total", "line_numbers", "aggregated_lines", "delivery_dates", "notes"],
      "properties": { "description": { "type": "string" }, "quantity": { "type": "number" }, "unit_price": { "type": ["number", "null"] }, "total": { "type": "number" },
        "line_numbers": { "type": "array", "items": { "type": "integer" } }, "aggregated_lines": { "type": "integer", "minimum": 1 },
        "delivery_dates": { "type": "array", "items": { "type": "string" } }, "notes": { "type": "array", "items": { "type": "string" } } } },
    "document": { "type": "object", "additionalProperties": false,
      "required": ["file_name", "sha256", "parser", "number", "supplier_name", "date", "currency", "line_count", "lines_total", "declared_total", "extra_charges", "needs_review", "manually_edited_lines", "issues", "lines"],
      "properties": {
        "file_name": { "type": "string" }, "sha256": { "type": "string" }, "parser": { "type": "string" }, "number": { "type": "string" },
        "supplier_name": { "type": "string" }, "date": { "type": "string" }, "currency": { "type": "string" }, "line_count": { "type": "integer" },
        "lines_total": { "$ref": "#/$defs/money" }, "declared_total": { "$ref": "#/$defs/nmoney" },
        "extra_charges": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["label", "amount"], "properties": { "label": { "type": "string" }, "amount": { "type": "number" } } } },
        "needs_review": { "type": "boolean" }, "manually_edited_lines": { "type": "integer" },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
        "lines": { "type": "array", "items": { "type": "object", "additionalProperties": false,
          "required": ["line_no", "reference", "description", "quantity", "unit_price", "total", "edited"],
          "properties": { "line_no": { "type": "integer" }, "reference": { "type": "string" }, "description": { "type": "string" }, "quantity": { "type": ["number", "null"] },
            "unit_price": { "type": ["number", "null"] }, "total": { "type": ["number", "null"] }, "edited": { "type": "boolean" } } } } } }
  },
  "properties": {
    "schema_version": { "const": "1.0" },
    "generated_at": { "type": "string" },
    "status": { "enum": ["draft", "confirmed"] },
    "confirmed_at": { "type": ["string", "null"] },
    "notes": { "type": "string" },
    "purchase_order": { "$ref": "#/$defs/document" },
    "supplier_confirmation": { "$ref": "#/$defs/document" },
    "cross_checks": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
    "statistics": { "type": "object", "additionalProperties": false,
      "required": ["po_lines", "supplier_lines", "po_unique_references", "supplier_unique_references", "po_aggregated_references", "supplier_aggregated_references", "references_in_both", "matched", "with_differences", "quantity_differences", "value_differences", "only_in_po", "only_in_supplier", "po_total", "supplier_total", "total_difference", "value_only_in_po", "value_only_in_supplier", "value_difference_on_matched_references"],
      "properties": {
        "po_lines": { "type": "integer" }, "supplier_lines": { "type": "integer" }, "po_unique_references": { "type": "integer" }, "supplier_unique_references": { "type": "integer" },
        "po_aggregated_references": { "type": "integer" }, "supplier_aggregated_references": { "type": "integer" }, "references_in_both": { "type": "integer" }, "matched": { "type": "integer" },
        "with_differences": { "type": "integer" }, "quantity_differences": { "type": "integer" }, "value_differences": { "type": "integer" }, "only_in_po": { "type": "integer" }, "only_in_supplier": { "type": "integer" },
        "po_total": { "type": "number" }, "supplier_total": { "type": "number" }, "total_difference": { "type": "number" }, "value_only_in_po": { "type": "number" }, "value_only_in_supplier": { "type": "number" }, "value_difference_on_matched_references": { "type": "number" } } },
    "items": { "type": "array", "items": { "type": "object", "additionalProperties": false,
      "required": ["reference", "brand", "po_reference", "status", "po", "supplier", "diff", "suggestion"],
      "properties": { "reference": { "type": "string" }, "brand": { "type": ["string", "null"] }, "po_reference": { "type": ["string", "null"] },
        "status": { "enum": ["match", "qty_diff", "value_diff", "qty_value_diff", "only_po", "only_supplier"] },
        "po": { "$ref": "#/$defs/side" }, "supplier": { "$ref": "#/$defs/side" },
        "diff": { "type": ["object", "null"], "additionalProperties": false, "required": ["quantity", "total", "unit_price"],
          "properties": { "quantity": { "type": "number" }, "total": { "type": "number" }, "unit_price": { "type": ["number", "null"] } } },
        "suggestion": { "type": ["string", "null"] } } } }
  }
}
